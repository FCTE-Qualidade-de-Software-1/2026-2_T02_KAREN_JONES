ub.com/users/dwelle","html_url":"https://github.com/dwelle","followers_url":"https://api.github.com/users/dwelle/followers","following_url":"https://api.github.com/users/dwelle/following{/other_user}","gists_url":"https://api.github.com/users/dwelle/gists{/gist_id}","starred_url":"https://api.github.com/users/dwelle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dwelle/subscriptions","organizations_url":"https://api.github.com/users/dwelle/orgs","repos_url":"https://api.github.com/users/dwelle/repos","events_url":"https://api.github.com/users/dwelle/events{/privacy}","received_events_url":"https://api.github.com/users/dwelle/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/excalidraw/excalidraw/actions/runs/34039447020/jobs","logs_url":"https://api.github.com/repos/excalidraw/excalidraw/actions/runs/34039447020/logs","check_suite_url":"https://api.github.com/repos/excalidraw/excalidraw/check-suites/92225987010","artifacts_url":"https://api.github.com/repos/excalidraw/excalidraw/actions/runs/34039447020/artifacts","cancel_url":"https://api.github.com/repos/excalidraw/excalidraw/actions/runs/34039447020/cancel","rerun_url":"https://api.github.com/repos/excalidraw/excalidraw/actions/runs/34039447020/rerun","previous_attempt_url":null,"workflow_url":"https://api.github.com/repos/excalidraw/excalidraw/actions/workflows/64850896","head_commit":{"id":"bb66c8ed5ac836f6e54c72c02807a8b50788dd34","tree_id":"2ab7666001b1ef2e69c02a31ea5d4e8103df2423","message":"perf(editor): stop inverting the interactive canvas via CSS filter in dark mode\n\nThe interactive canvas (selection outlines, transform handles, binding\nhighlights, collaborator cursors, snap lines, scrollbars) was still\ncomposited through `filter: invert(93%) hue-rotate(180deg)` in dark mode\n(#10578 only de-filtered the static canvas). The canvas covers the whole\nviewport and repaints on nearly every pointer move, so browsers that\ncomposite in software (Firefox/Zen on software WebRender or with hardware\nacceleration disabled) paid for a full-viewport color-matrix pass per frame\nand dropped from 120fps to ~40fps during marquee/drag. Light mode was\nunaffected.\n\nColors are now mapped in JS via `applyDarkModeFilter`, like the static\ncanvas. Hardcoded dark-mode values are the exact post-filter equivalents of\nthe previous ones, so rendering is unchanged, with two intentional\nexceptions:\n\n- collaborator cursors and remote selection outlines render in the\n  collaborators' actual colors (matching their avatars) instead of inverted\n  ones (per the existing TODO in clients.ts)\n- the lasso trail now uses the theme's `--color-selection` like the marquee\n  selection, instead of a hardcoded light-theme purple that never matched in\n  dark mode\n\n`--color-selection` for the dark theme now holds the actual rendered color\n(#b4b0ff); hosts overriding it no longer need to pre-invert.\n\nCo-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>","timestamp":"2026-09-06T14:31:44Z","author":{"name":"dwelle","email":"5153846+dwelle@users.noreply.github.com"},"committer":{"name":"dwelle","email":"5153846+dwelle@users.noreply.github.com"}},"repository":{"id":231283452,"node_id":"MDEwOlJlcG9zaXRvcnkyMzEyODM0NTI=","name":"excalidraw","full_name":"excalidraw/excalidraw","private":false,"owner":{"login":"excalidraw","id":59452120,"node_id":"MDEyOk9yZ2FuaXphdGlvbjU5NDUyMTIw","avatar_url":"https://avatars.githubusercontent.com/u/59452120?v=4","gravatar_id":"","url":"https://api.github.com/users/excalidraw","html_url":"https://github.com/excalidraw","followers_url":"https://api.github.com/users/excalidraw/followers","following_url":"https://api.github.com/users/excalidraw/following{/other_user}","gists_url":"https://api.github.com/users/excalidraw/gists{/gist_id}","starred_url":"https://api.github.com/users/excalidraw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/excalidr
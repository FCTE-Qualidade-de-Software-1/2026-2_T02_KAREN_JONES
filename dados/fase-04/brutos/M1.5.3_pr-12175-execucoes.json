{"total_count":1,"workflow_runs":[{"id":36268122219,"name":"Test Coverage PR","node_id":"WFR_kwLODcka_M8AAAAIcb-gaw","head_branch":"dwelle/fix-caret-overflow","head_sha":"c5c5b182f3c972f92eebbaea0c9d38b29c2f148d","path":".github/workflows/test-coverage-pr.yml","display_title":"fix(editor): pan the canvas to follow the caret instead of shifting the UI","run_number":8748,"event":"pull_request","status":"completed","conclusion":"success","workflow_id":64850896,"check_suite_id":98213219583,"check_suite_node_id":"CS_kwDODcka_M8AAAAW3fbM_w","url":"https://api.github.com/repos/excalidraw/excalidraw/actions/runs/36268122219","html_url":"https://github.com/excalidraw/excalidraw/actions/runs/36268122219","pull_requests":[],"created_at":"2026-09-26T20:02:31Z","updated_at":"2026-09-26T20:07:18Z","actor":{"login":"dwelle","id":5153846,"node_id":"MDQ6VXNlcjUxNTM4NDY=","avatar_url":"https://avatars.githubusercontent.com/u/5153846?v=4","gravatar_id":"","url":"https://api.github.com/users/dwelle","html_url":"https://github.com/dwelle","followers_url":"https://api.github.com/users/dwelle/followers","following_url":"https://api.github.com/users/dwelle/following{/other_user}","gists_url":"https://api.github.com/users/dwelle/gists{/gist_id}","starred_url":"https://api.github.com/users/dwelle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dwelle/subscriptions","organizations_url":"https://api.github.com/users/dwelle/orgs","repos_url":"https://api.github.com/users/dwelle/repos","events_url":"https://api.github.com/users/dwelle/events{/privacy}","received_events_url":"https://api.github.com/users/dwelle/received_events","type":"User","user_view_type":"public","site_admin":false},"run_attempt":1,"referenced_workflows":[],"run_started_at":"2026-09-26T20:02:31Z","triggering_actor":{"login":"dwelle","id":5153846,"node_id":"MDQ6VXNlcjUxNTM4NDY=","avatar_url":"https://avatars.githubusercontent.com/u/5153846?v=4","gravatar_id":"","url":"https://api.github.com/users/dwelle","html_url":"https://github.com/dwelle","followers_url":"https://api.github.com/users/dwelle/followers","following_url":"https://api.github.com/users/dwelle/following{/other_user}","gists_url":"https://api.github.com/users/dwelle/gists{/gist_id}","starred_url":"https://api.github.com/users/dwelle/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dwelle/subscriptions","organizations_url":"https://api.github.com/users/dwelle/orgs","repos_url":"https://api.github.com/users/dwelle/repos","events_url":"https://api.github.com/users/dwelle/events{/privacy}","received_events_url":"https://api.github.com/users/dwelle/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/excalidraw/excalidraw/actions/runs/36268122219/jobs","logs_url":"https://api.github.com/repos/excalidraw/excalidraw/actions/runs/36268122219/logs","check_suite_url":"https://api.github.com/repos/excalidraw/excalidraw/check-suites/98213219583","artifacts_url":"https://api.github.com/repos/excalidraw/excalidraw/actions/runs/36268122219/artifacts","cancel_url":"https://api.github.com/repos/excalidraw/excalidraw/actions/runs/36268122219/cancel","rerun_url":"https://api.github.com/repos/excalidraw/excalidraw/actions/runs/36268122219/rerun","previous_attempt_url":null,"workflow_url":"https://api.github.com/repos/excalidraw/excalidraw/actions/workflows/64850896","head_commit":{"id":"c5c5b182f3c972f92eebbaea0c9d38b29c2f148d","tree_id":"58be3cf23763b8fa6f19d4b033bbf9483fbd5b02","message":"feat(editor): a text stops growing at the view's width, and is brought into view when it wraps\n\nCloses #8855. Typing a long line grew a free text past the view's edge.\nThe canvas followed the caret, so the start of the text went out of view\non the other side, and the box had to be resized by hand afterwards.\n\nA free text that grows with its content (`autoResize`) now stops at the\nview's width: the canvas minus the sidebar, less TEXT_VIEWPORT_PADDING\n(20px, in @excalidraw/common) at each side, in scene units, so it follows\nthe zoom. On the keystroke that would cross it, the text becomes fixed\nwidth at exactly that width and wraps from then on (`autoResize: false`),\nanchored the way it grew, so a right-aligned or centered text keeps its\nedge or center. The editor switches to wrapping with it. A text that is\nalready wider keeps growing; nothing shrinks. The rule is an optional\n`maxWidth` on `refreshTextDimensions`, which the editor's per-keystroke\nupdate passes.\n\nWhen a text starts wrapping in the editor, while typed or pasted into it,\nit is scrolled into view with the same room at the edges. Being exactly\nthe padded view's width, it then fills it. That happens horizontally\nalways, and vertically only if all of it fits; a taller text leaves the\nvertical to the caret-follow, so the view doesn't jump away from the caret.\n\nPasting onto the canvas keeps its wrap width (half the view, 200-800),\ncapped by the same limit, so that the 200 minimum can't outgrow a narrow\nor zoomed-in view. A paste that wrapped is scrolled fully into view; if\nit is taller than the view, its top is brought in.\n\nScrolling into view is computed by a pure `scrollBoundsIntoView` in\nviewport.ts, next to `centerScrollOn` and `constrainScrollState`. It moves\nby the least amount, keeps the zoom, takes the usable area as `Offsets`,\nand returns null when nothing needs to move. The move itself goes through\n`viewport.translate`, as a user pan does: it respects scroll locks, yields\nto a host's pending locked navigation, and stops following a\ncollaborator. No move, no translate.\n\nMeasured with real input in Chromium on a 2560px view: typing\ncharacter by character at 400% from 100px in, and a sentence inserted at\nonce, both end as a wrapped text from 20 to 2540; with the docked sidebar\nthe limit is 2226 (2560 - 294 - 40) and the text sits 20px left of it; a\npaste near the bottom-right corner ends 20px inside the right and bottom\nedges. Nothing scrolled the page or the editor box.\n\nTests: the text stops and wraps at the view's width, and keeps that width;\nthe limit follows the zoom and a docked sidebar; a right-aligned text keeps\nits right edge; a text already wider keeps growing (the not-cut-off test,\nreworked); starting to wrap scrolls it into view with room at its right\nedge, but not vertically when it's taller than the view; a paste isn't\nwider than the view at 800% and, wrapped, ends fully in view;\n`scrollBoundsIntoView` unit tests.\n\nClaude Opus 5.5 (1M), xhigh effort","timestamp":"2026-09-26T19:34:30Z","author":{"name":"dwelle","email":"5153846+dwelle@users.noreply.github.com"},"committer":{"name":"dwelle","email":"5153846+dwelle@users.noreply.github.com"}},"repository":{"id":231283452,"node_id":"MDEwOlJlcG9zaXRvcnkyMzEyODM0NTI=","name":"excalidraw","full_name":"excalidraw/excalidraw","private":false,"owner":{"login":"excalidraw","id":59452120,"node_id":"MDEyOk9yZ2FuaXphdGlvbjU5NDUyMTIw","avatar_url":"https://avatars.githubusercontent.com/u/59452120?v=4","gravatar_id":"","url":"https://api.github.com/users/excalidraw","html_url":"https://github.com/excalidraw","followers_url":"https://api.github.com/users/excalidraw/followers","following_url":"https://api.github.com/users/excalidraw/following{/other_user}","gists_url":"https://api.github.com/users/excalidraw/gists{/gist_id}","starred_url":"https://api.github.com/users/excalidraw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/excalidraw/subscriptions","organizations_url":"https://api.github.com/users/excalidraw/orgs","repos_url":"https://api.github.com/users/excalidraw/repos","events_url":"https://api.github.com/users/excalidraw/events{/privacy}","received_events_url":"https://api.github.com/users/excalidraw/received_events","type":"Organization","user_view_type":"public","site_admin":false},"html_url":"https://github.com/excalidraw/excalidraw","description":"Virtual whiteboard for